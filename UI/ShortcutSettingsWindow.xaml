<Window x:Class="FoxBrowser.UI.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FoxBrowser.UI"
        Title="Клавіатурні скорочення" Width="580" Height="390"
        MinWidth="520" Background="#15171A" Foreground="#F2F4F7"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Клавіатурні скорочення" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
        <local:ShortcutsPanel Grid.Row="1" />
        <Button Grid.Row="2" Content="Закрити" Click="Close_Click" Padding="14,6" HorizontalAlignment="Right" Margin="0,14,0,0" />
    </Grid>
</Window>
