<Window x:Class="FoxBrowser.UI.TabRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перейменувати вкладку" Width="360" Height="180"
        Background="#15171A" Foreground="#F2F4F7"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="Назва вкладки" Margin="0,0,0,8" />
        <TextBox x:Name="TitleBox" Grid.Row="1" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Скасувати" Click="Cancel_Click" Padding="10,5" Margin="0,0,8,0" />
            <Button Content="OK" Click="Ok_Click" Padding="14,5" />
        </StackPanel>
    </Grid>
</Window>
