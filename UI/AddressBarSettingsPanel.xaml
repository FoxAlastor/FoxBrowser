<UserControl x:Class="FoxBrowser.UI.AddressBarSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <RadioButton x:Name="ManualRadio" Content="Вручну (за шорткатом)" Foreground="#F2F4F7" Margin="0,0,0,6" Checked="Mode_Changed" />
        <RadioButton x:Name="TimerRadio" Content="Автоматично (за таймером)" Foreground="#F2F4F7" Margin="0,0,0,10" Checked="Mode_Changed" />
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
            <TextBlock Text="Ховати через, с" VerticalAlignment="Center" />
            <TextBox x:Name="SecondsBox" Grid.Column="1" TextChanged="Seconds_Changed" />
        </Grid>
        <TextBlock x:Name="ShortcutHint" Foreground="#AEB4BE" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
