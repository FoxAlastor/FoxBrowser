<Window x:Class="FoxBrowser.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FoxBrowser.UI"
        Title="Налаштування" Width="640" Height="600" MinWidth="560" MinHeight="480"
        Background="#15171A" Foreground="#F2F4F7"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="#000000" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="BorderBrush" Value="#000000" />
                <Setter Property="Width" Value="12" />
            </Style>
        </ScrollViewer.Resources>
        <StackPanel Margin="22">
            <TextBlock Text="Назва та іконка" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <local:AppIdentityPanel x:Name="IdentityPanel" />
            <Separator Margin="0,20,0,18" />
            <TextBlock Text="Адресна панель" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <local:AddressBarSettingsPanel x:Name="AddressPanel" />
            <Separator Margin="0,20,0,18" />
            <TextBlock Text="Вікно" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <local:WindowSettingsPanel x:Name="WindowPanel" />
            <Separator Margin="0,20,0,18" />
            <TextBlock Text="Клавіатурні скорочення" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <local:ShortcutsPanel />
            <Button Content="Закрити" Click="Close_Click" Padding="14,6" HorizontalAlignment="Right" Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
