<Window x:Class="FoxBrowser.UI.BlockedElementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вирізані елементи" Width="620" Height="430" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource HeaderBg}" Foreground="{StaticResource TextPrimary}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Видалити вибране правило" Click="RemoveSelected_Click" Padding="10,6" />
            <Button Content="Очистити сайт" Click="ClearSite_Click" Padding="10,6" Margin="8,0,0,0" />
            <Button Content="Закрити" Click="Close_Click" Padding="10,6" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Заблоковані елементи" FontSize="16" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Text="Вибери конкретне правило, щоб повернути один елемент. Правила діють лише для поточного сайту." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,10" />
        <ListBox x:Name="SelectorList" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderMedium}" Foreground="{StaticResource TextPrimary}" />
    </DockPanel>
</Window>
