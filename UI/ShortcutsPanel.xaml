<UserControl x:Class="FoxBrowser.UI.ShortcutsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Натисніть «Змінити», потім потрібну комбінацію Ctrl/Shift/Alt + клавіша." Foreground="#AEB4BE" Margin="0,0,0,12" TextWrapping="Wrap" />
        <StackPanel x:Name="ShortcutList" />
        <Button Content="Скинути до стандартних" Click="Reset_Click" Padding="10,6" HorizontalAlignment="Right" Margin="0,6,0,0" />
    </StackPanel>
</UserControl>
