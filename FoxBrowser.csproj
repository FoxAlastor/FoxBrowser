<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FoxBrowser</AssemblyName>
    <RootNamespace>FoxBrowser</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>FoxBrowser.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="OCR Translate\**" />
    <Page Remove="OCR Translate\**" />
    <None Remove="OCR Translate\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="FoxBrowser.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="FoxBrowser.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
